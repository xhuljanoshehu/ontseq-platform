{
  "$defs": {
    "AlignedBamIntakeReport": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/ValidationCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "genome_build": {
          "$ref": "#/$defs/GenomeBuild"
        },
        "header": {
          "anyOf": [
            {
              "$ref": "#/$defs/BamHeaderSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "index_fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileFingerprint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileFingerprint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "reference_id": {
          "title": "Reference Id",
          "type": "string"
        },
        "sample_id": {
          "title": "Sample Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "sample_id",
        "reference_id",
        "genome_build",
        "checks",
        "verdict"
      ],
      "title": "AlignedBamIntakeReport",
      "type": "object"
    },
    "BamHeaderSummary": {
      "additionalProperties": false,
      "properties": {
        "contig_signature_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contig Signature Sha256",
          "type": "string"
        },
        "program_count": {
          "minimum": 0,
          "title": "Program Count",
          "type": "integer"
        },
        "read_group_count": {
          "minimum": 0,
          "title": "Read Group Count",
          "type": "integer"
        },
        "sample_tag_count": {
          "minimum": 0,
          "title": "Sample Tag Count",
          "type": "integer"
        },
        "sequence_count": {
          "minimum": 0,
          "title": "Sequence Count",
          "type": "integer"
        },
        "sort_order": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sort Order"
        },
        "total_reference_bases": {
          "minimum": 0,
          "title": "Total Reference Bases",
          "type": "integer"
        }
      },
      "required": [
        "sequence_count",
        "total_reference_bases",
        "contig_signature_sha256",
        "read_group_count",
        "sample_tag_count",
        "program_count"
      ],
      "title": "BamHeaderSummary",
      "type": "object"
    },
    "CheckStatus": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL"
      ],
      "title": "CheckStatus",
      "type": "string"
    },
    "CraminoQCReport": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "qc": {
          "$ref": "#/$defs/QCMetrics"
        },
        "sample_id": {
          "title": "Sample Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tool": {
          "$ref": "#/$defs/ToolRecord"
        }
      },
      "required": [
        "sample_id",
        "qc",
        "tool"
      ],
      "title": "CraminoQCReport",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "chromosome_gain",
        "chromosome_loss",
        "deletion",
        "duplication",
        "inversion",
        "translocation",
        "insertion",
        "fusion"
      ],
      "title": "EventType",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "caller": {
          "title": "Caller",
          "type": "string"
        },
        "caller_version": {
          "title": "Caller Version",
          "type": "string"
        },
        "coverage_context": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "title": "Coverage Context",
          "type": "array"
        },
        "filters": {
          "items": {
            "type": "string"
          },
          "title": "Filters",
          "type": "array"
        },
        "length_standard_deviation": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Standard Deviation"
        },
        "local_coverage": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Coverage"
        },
        "mean_alignment_nm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Alignment Nm"
        },
        "position_standard_deviation": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position Standard Deviation"
        },
        "precise": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precise"
        },
        "quality": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality"
        },
        "support_reads": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Support Reads"
        },
        "supporting_read_strands": {
          "anyOf": [
            {
              "pattern": "^(?:\\+|-|\\+-)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supporting Read Strands"
        },
        "variant_allele_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Allele Fraction"
        }
      },
      "required": [
        "caller",
        "caller_version"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FileFingerprint": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "size_bytes"
      ],
      "title": "FileFingerprint",
      "type": "object"
    },
    "GenomeBuild": {
      "enum": [
        "GRCh37",
        "GRCh38"
      ],
      "title": "GenomeBuild",
      "type": "string"
    },
    "GenomicEvent": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "default": "unclassified",
          "enum": [
            "high",
            "moderate",
            "low",
            "unclassified"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "copy_number": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Copy Number"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/EventType"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "genes": {
          "items": {
            "type": "string"
          },
          "title": "Genes",
          "type": "array"
        },
        "length_bp": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Bp"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "primary": {
          "$ref": "#/$defs/Locus"
        },
        "reportable": {
          "default": false,
          "title": "Reportable",
          "type": "boolean"
        },
        "secondary": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "event_id",
        "event_type",
        "primary"
      ],
      "title": "GenomicEvent",
      "type": "object"
    },
    "Locus": {
      "additionalProperties": false,
      "properties": {
        "chromosome": {
          "pattern": "^(?:chr)?(?:[1-9]|1[0-9]|2[0-2]|X|Y)$",
          "title": "Chromosome",
          "type": "string"
        },
        "cytoband_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cytoband End"
        },
        "cytoband_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cytoband Start"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "gene": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gene"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "chromosome",
        "start",
        "end"
      ],
      "title": "Locus",
      "type": "object"
    },
    "ModuleRunStatus": {
      "enum": [
        "COMPLETED",
        "NOT_RUN",
        "FAILED",
        "NO_CALL"
      ],
      "title": "ModuleRunStatus",
      "type": "string"
    },
    "QCMetrics": {
      "additionalProperties": false,
      "properties": {
        "failed_gates": {
          "items": {
            "type": "string"
          },
          "title": "Failed Gates",
          "type": "array"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "verdict",
        "metrics"
      ],
      "title": "QCMetrics",
      "type": "object"
    },
    "SnifflesCallReport": {
      "additionalProperties": false,
      "properties": {
        "accepted_record_count": {
          "minimum": 0,
          "title": "Accepted Record Count",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/GenomicEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "genome_build": {
          "$ref": "#/$defs/GenomeBuild"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "policy": {
          "$ref": "#/$defs/SnifflesPolicy"
        },
        "raw_record_count": {
          "minimum": 0,
          "title": "Raw Record Count",
          "type": "integer"
        },
        "rejected_record_count": {
          "minimum": 0,
          "title": "Rejected Record Count",
          "type": "integer"
        },
        "rejection_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Rejection Counts",
          "type": "object"
        },
        "research_only": {
          "const": true,
          "default": true,
          "title": "Research Only",
          "type": "boolean"
        },
        "sample_id": {
          "title": "Sample Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ModuleRunStatus"
        },
        "tool": {
          "$ref": "#/$defs/ToolRecord"
        },
        "vcf_fingerprint": {
          "$ref": "#/$defs/FileFingerprint"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "sample_id",
        "genome_build",
        "status",
        "policy",
        "events",
        "raw_record_count",
        "accepted_record_count",
        "rejected_record_count",
        "tool",
        "vcf_fingerprint"
      ],
      "title": "SnifflesCallReport",
      "type": "object"
    },
    "SnifflesMode": {
      "enum": [
        "germline",
        "mosaic"
      ],
      "title": "SnifflesMode",
      "type": "string"
    },
    "SnifflesPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed_sv_types": {
          "items": {
            "$ref": "#/$defs/EventType"
          },
          "minItems": 1,
          "title": "Allowed Sv Types",
          "type": "array"
        },
        "expected_version": {
          "default": "2.8.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Expected Version",
          "type": "string"
        },
        "mapq": {
          "default": 20,
          "maximum": 60,
          "minimum": 0,
          "title": "Mapq",
          "type": "integer"
        },
        "min_support": {
          "default": 5,
          "minimum": 1,
          "title": "Min Support",
          "type": "integer"
        },
        "min_sv_length": {
          "default": 50,
          "minimum": 1,
          "title": "Min Sv Length",
          "type": "integer"
        },
        "minimum_quality": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Quality"
        },
        "mode": {
          "$ref": "#/$defs/SnifflesMode",
          "default": "germline"
        },
        "note": {
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "pass_only": {
          "const": true,
          "default": true,
          "title": "Pass Only",
          "type": "boolean"
        },
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "require_precise": {
          "default": false,
          "title": "Require Precise",
          "type": "boolean"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "technical_defaults_only",
            "validated"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "status",
        "note"
      ],
      "title": "SnifflesPolicy",
      "type": "object"
    },
    "ToolRecord": {
      "additionalProperties": false,
      "properties": {
        "container_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Digest"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ToolRecord",
      "type": "object"
    },
    "ValidationCheck": {
      "additionalProperties": false,
      "properties": {
        "details": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus"
        }
      },
      "required": [
        "name",
        "status",
        "message"
      ],
      "title": "ValidationCheck",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "NOT_RUN"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/ValidationCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "intake": {
      "$ref": "#/$defs/AlignedBamIntakeReport"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "qc": {
      "$ref": "#/$defs/CraminoQCReport"
    },
    "research_only": {
      "const": true,
      "default": true,
      "title": "Research Only",
      "type": "boolean"
    },
    "sample_id": {
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sniffles": {
      "$ref": "#/$defs/SnifflesCallReport"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    }
  },
  "required": [
    "sample_id",
    "verdict",
    "intake",
    "qc",
    "sniffles",
    "checks"
  ],
  "title": "LocalSmokeReport",
  "type": "object"
}
