{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allele_index": {
      "minimum": 1,
      "title": "Allele Index",
      "type": "integer"
    },
    "alt": {
      "title": "Alt",
      "type": "string"
    },
    "alt_depth": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Alt Depth"
    },
    "caller": {
      "const": "GATK Mutect2",
      "default": "GATK Mutect2",
      "title": "Caller",
      "type": "string"
    },
    "chromosome": {
      "title": "Chromosome",
      "type": "string"
    },
    "clinically_reportable": {
      "const": false,
      "default": false,
      "title": "Clinically Reportable",
      "type": "boolean"
    },
    "coordinate_system": {
      "const": "zero_based_half_open",
      "default": "zero_based_half_open",
      "title": "Coordinate System",
      "type": "string"
    },
    "depth": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Depth"
    },
    "end0": {
      "minimum": 1,
      "title": "End0",
      "type": "integer"
    },
    "evidence_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Id",
      "type": "string"
    },
    "left_aligned": {
      "const": false,
      "default": false,
      "title": "Left Aligned",
      "type": "boolean"
    },
    "native_allele_filter_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Allele Filter Status"
    },
    "native_pos1": {
      "minimum": 1,
      "title": "Native Pos1",
      "type": "integer"
    },
    "native_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Native Record Sha256",
      "type": "string"
    },
    "native_site_filter": {
      "title": "Native Site Filter",
      "type": "string"
    },
    "normal_af": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Normal Af"
    },
    "ref": {
      "title": "Ref",
      "type": "string"
    },
    "ref_depth": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ref Depth"
    },
    "research_only": {
      "const": true,
      "default": true,
      "title": "Research Only",
      "type": "boolean"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "sample_id": {
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_line_number": {
      "minimum": 1,
      "title": "Source Line Number",
      "type": "integer"
    },
    "source_vcf_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Vcf Sha256",
      "type": "string"
    },
    "start0": {
      "minimum": 0,
      "title": "Start0",
      "type": "integer"
    },
    "tumor_af": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tumor Af"
    },
    "variant_type": {
      "enum": [
        "SNV",
        "MNV",
        "INS",
        "DEL",
        "COMPLEX"
      ],
      "title": "Variant Type",
      "type": "string"
    }
  },
  "required": [
    "evidence_id",
    "run_id",
    "sample_id",
    "chromosome",
    "start0",
    "end0",
    "native_pos1",
    "ref",
    "alt",
    "allele_index",
    "variant_type",
    "native_site_filter",
    "native_record_sha256",
    "source_vcf_sha256",
    "source_line_number"
  ],
  "title": "SmallVariantCandidate",
  "type": "object"
}
