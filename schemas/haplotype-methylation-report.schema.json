{
  "$defs": {
    "FileFingerprint": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "size_bytes"
      ],
      "title": "FileFingerprint",
      "type": "object"
    },
    "GenomeBuild": {
      "enum": [
        "GRCh37",
        "GRCh38"
      ],
      "title": "GenomeBuild",
      "type": "string"
    },
    "Haplotype": {
      "enum": [
        "HP1",
        "HP2"
      ],
      "title": "Haplotype",
      "type": "string"
    },
    "HaplotypeAssessability": {
      "enum": [
        "ASSESSABLE",
        "NOT_ASSESSABLE"
      ],
      "title": "HaplotypeAssessability",
      "type": "string"
    },
    "HaplotypeCall": {
      "additionalProperties": false,
      "description": "One haplotype of one region and modification code.",
      "properties": {
        "assessability": {
          "$ref": "#/$defs/HaplotypeAssessability"
        },
        "haplotype": {
          "$ref": "#/$defs/Haplotype"
        },
        "informative_reads": {
          "minimum": 0,
          "title": "Informative Reads",
          "type": "integer"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/NotAssessableReason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "summary": {
          "$ref": "#/$defs/MethylationRegionSummary"
        }
      },
      "required": [
        "haplotype",
        "informative_reads",
        "summary",
        "assessability"
      ],
      "title": "HaplotypeCall",
      "type": "object"
    },
    "HaplotypeMethylationPolicy": {
      "additionalProperties": false,
      "description": "Versioned technical settings of the haplotype lane. None is a validated threshold.",
      "properties": {
        "accepted_phasing_programs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Accepted Phasing Programs",
          "type": "array"
        },
        "combine_strands": {
          "default": true,
          "title": "Combine Strands",
          "type": "boolean"
        },
        "cpg_only": {
          "default": true,
          "title": "Cpg Only",
          "type": "boolean"
        },
        "expected_version": {
          "default": "0.6.4",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Expected Version",
          "type": "string"
        },
        "filter_threshold": {
          "default": 0.8,
          "maximum": 1,
          "minimum": 0,
          "title": "Filter Threshold",
          "type": "number"
        },
        "minimum_informative_reads_per_haplotype": {
          "default": 5,
          "minimum": 1,
          "title": "Minimum Informative Reads Per Haplotype",
          "type": "integer"
        },
        "minimum_sites_at_floor_per_haplotype": {
          "default": 3,
          "minimum": 1,
          "title": "Minimum Sites At Floor Per Haplotype",
          "type": "integer"
        },
        "minimum_valid_coverage": {
          "default": 5,
          "minimum": 1,
          "title": "Minimum Valid Coverage",
          "type": "integer"
        },
        "modification_codes": {
          "items": {
            "$ref": "#/$defs/ModificationCode"
          },
          "minItems": 1,
          "title": "Modification Codes",
          "type": "array"
        },
        "note": {
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "technical_defaults_only",
            "validated"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "status",
        "note"
      ],
      "title": "HaplotypeMethylationPolicy",
      "type": "object"
    },
    "HaplotypeRegionRow": {
      "additionalProperties": false,
      "description": "One region and modification code, split by haplotype.",
      "properties": {
        "chromosome": {
          "title": "Chromosome",
          "type": "string"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "haplotype_difference": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Haplotype Difference"
        },
        "hp1": {
          "$ref": "#/$defs/HaplotypeCall"
        },
        "hp2": {
          "$ref": "#/$defs/HaplotypeCall"
        },
        "modification_code": {
          "$ref": "#/$defs/ModificationCode"
        },
        "modification_name": {
          "title": "Modification Name",
          "type": "string"
        },
        "phase_sets": {
          "items": {
            "type": "integer"
          },
          "title": "Phase Sets",
          "type": "array"
        },
        "region_id": {
          "minLength": 1,
          "title": "Region Id",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "unphased": {
          "$ref": "#/$defs/MethylationRegionSummary"
        },
        "unphased_informative_reads": {
          "minimum": 0,
          "title": "Unphased Informative Reads",
          "type": "integer"
        }
      },
      "required": [
        "region_id",
        "chromosome",
        "start",
        "end",
        "modification_code",
        "modification_name",
        "phase_sets",
        "hp1",
        "hp2",
        "unphased",
        "unphased_informative_reads"
      ],
      "title": "HaplotypeRegionRow",
      "type": "object"
    },
    "MethylationRegionSummary": {
      "additionalProperties": false,
      "description": "One region, one modification code.\n\n``start``/``end`` are present for BED-derived rows and absent for chromosome rows: the\nadapter aggregates the pileup it was given and does not read contig lengths, so it\ncannot honestly claim a chromosome span it never saw.",
      "properties": {
        "canonical_call_count": {
          "default": 0,
          "minimum": 0,
          "title": "Canonical Call Count",
          "type": "integer"
        },
        "chromosome": {
          "pattern": "^(?:chr)?(?:[1-9]|1[0-9]|2[0-2]|X|Y)$",
          "title": "Chromosome",
          "type": "string"
        },
        "delete_call_count": {
          "default": 0,
          "minimum": 0,
          "title": "Delete Call Count",
          "type": "integer"
        },
        "diff_call_count": {
          "default": 0,
          "minimum": 0,
          "title": "Diff Call Count",
          "type": "integer"
        },
        "end": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "fail_call_count": {
          "default": 0,
          "minimum": 0,
          "title": "Fail Call Count",
          "type": "integer"
        },
        "mean_modified_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Modified Fraction"
        },
        "mean_valid_coverage": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Valid Coverage"
        },
        "median_site_modified_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median Site Modified Fraction"
        },
        "modification_code": {
          "$ref": "#/$defs/ModificationCode"
        },
        "modification_name": {
          "minLength": 1,
          "title": "Modification Name",
          "type": "string"
        },
        "modified_call_count": {
          "minimum": 0,
          "title": "Modified Call Count",
          "type": "integer"
        },
        "nocall_call_count": {
          "default": 0,
          "minimum": 0,
          "title": "Nocall Call Count",
          "type": "integer"
        },
        "other_mod_call_count": {
          "default": 0,
          "minimum": 0,
          "title": "Other Mod Call Count",
          "type": "integer"
        },
        "region_id": {
          "minLength": 1,
          "title": "Region Id",
          "type": "string"
        },
        "sites_at_minimum_coverage": {
          "minimum": 0,
          "title": "Sites At Minimum Coverage",
          "type": "integer"
        },
        "sites_total": {
          "minimum": 0,
          "title": "Sites Total",
          "type": "integer"
        },
        "start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "valid_call_count": {
          "minimum": 0,
          "title": "Valid Call Count",
          "type": "integer"
        }
      },
      "required": [
        "region_id",
        "chromosome",
        "modification_code",
        "modification_name",
        "sites_total",
        "sites_at_minimum_coverage",
        "valid_call_count",
        "modified_call_count"
      ],
      "title": "MethylationRegionSummary",
      "type": "object"
    },
    "ModificationCode": {
      "description": "The modified-base codes this adapter is prepared to normalize.\n\nDeliberately a closed set. modkit reports whatever the basecalling model emitted, and\na code nobody planned for must surface as a refusal rather than be dropped on the\nfloor: silently discarding ``h`` rows from a 5mC+5hmC model would understate total\nmodification without anything in the report saying so.",
      "enum": [
        "m",
        "h",
        "a"
      ],
      "title": "ModificationCode",
      "type": "string"
    },
    "ModuleRunStatus": {
      "enum": [
        "COMPLETED",
        "NOT_RUN",
        "FAILED",
        "NO_CALL"
      ],
      "title": "ModuleRunStatus",
      "type": "string"
    },
    "NotAssessableReason": {
      "enum": [
        "NO_PHASED_READS",
        "MULTIPLE_PHASE_BLOCKS",
        "INSUFFICIENT_READS",
        "INSUFFICIENT_SITES"
      ],
      "title": "NotAssessableReason",
      "type": "string"
    },
    "PhasingProvenance": {
      "additionalProperties": false,
      "description": "A haplotagging step recorded in the BAM header (``@PG``).",
      "properties": {
        "command_line_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Command Line Sha256",
          "type": "string"
        },
        "program": {
          "minLength": 1,
          "title": "Program",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "program",
        "command_line_sha256"
      ],
      "title": "PhasingProvenance",
      "type": "object"
    },
    "ToolRecord": {
      "additionalProperties": false,
      "properties": {
        "container_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Digest"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ToolRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bedmethyl_fingerprints": {
      "additionalProperties": {
        "$ref": "#/$defs/FileFingerprint"
      },
      "title": "Bedmethyl Fingerprints",
      "type": "object"
    },
    "genome_build": {
      "$ref": "#/$defs/GenomeBuild"
    },
    "informative_read_definition": {
      "const": "mapped primary alignment overlapping the region, not secondary, supplementary, QC-failed or duplicate-flagged",
      "default": "mapped primary alignment overlapping the region, not secondary, supplementary, QC-failed or duplicate-flagged",
      "title": "Informative Read Definition",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "phasing": {
      "items": {
        "$ref": "#/$defs/PhasingProvenance"
      },
      "minItems": 1,
      "title": "Phasing",
      "type": "array"
    },
    "policy": {
      "$ref": "#/$defs/HaplotypeMethylationPolicy"
    },
    "reads_with_haplotype_tags": {
      "minimum": 1,
      "title": "Reads With Haplotype Tags",
      "type": "integer"
    },
    "reads_with_modified_base_tags": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reads With Modified Base Tags"
    },
    "region_bed_fingerprint": {
      "$ref": "#/$defs/FileFingerprint"
    },
    "research_only": {
      "const": true,
      "default": true,
      "title": "Research Only",
      "type": "boolean"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/HaplotypeRegionRow"
      },
      "title": "Rows",
      "type": "array"
    },
    "sample_id": {
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ModuleRunStatus"
    },
    "summary_metrics": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Summary Metrics",
      "type": "object"
    },
    "tool": {
      "$ref": "#/$defs/ToolRecord"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "sample_id",
    "genome_build",
    "status",
    "policy",
    "phasing",
    "reads_with_haplotype_tags",
    "bedmethyl_fingerprints",
    "region_bed_fingerprint",
    "tool"
  ],
  "title": "HaplotypeMethylationReport",
  "type": "object"
}
