{
  "$defs": {
    "AnalysisIntent": {
      "description": "Whether this analysis is looking for acquired or inherited variation.\n\nLoad-bearing for knowledge-base annotation: ClinVar classifies germline variation under\nACMG rules, and an AML workup asks a somatic question. Pairing the two without saying so\npresents an inherited-disease classification as though it answered a question about a\ntumour.",
      "enum": [
        "somatic",
        "germline",
        "both"
      ],
      "title": "AnalysisIntent",
      "type": "string"
    },
    "AnalysisModule": {
      "enum": [
        "qc",
        "cnv",
        "sv",
        "fusion",
        "iscn",
        "report",
        "small_variants",
        "methylation"
      ],
      "title": "AnalysisModule",
      "type": "string"
    },
    "AnalysisSpec": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisIntent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "modules": {
          "items": {
            "$ref": "#/$defs/AnalysisModule"
          },
          "title": "Modules",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "profile": {
          "minLength": 1,
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "profile",
        "modules"
      ],
      "title": "AnalysisSpec",
      "type": "object"
    },
    "AssayMode": {
      "enum": [
        "lcwgs",
        "adaptive_sampling"
      ],
      "title": "AssayMode",
      "type": "string"
    },
    "AssaySpec": {
      "additionalProperties": false,
      "properties": {
        "genome_build": {
          "$ref": "#/$defs/GenomeBuild"
        },
        "mode": {
          "$ref": "#/$defs/AssayMode"
        },
        "reference_id": {
          "minLength": 1,
          "title": "Reference Id",
          "type": "string"
        },
        "target_bed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Bed"
        },
        "target_bed_role": {
          "$ref": "#/$defs/TargetBedRole",
          "default": "analysis_roi_unbuffered"
        },
        "target_bed_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Bed Version"
        }
      },
      "required": [
        "mode",
        "genome_build",
        "reference_id"
      ],
      "title": "AssaySpec",
      "type": "object"
    },
    "BreakpointAnnotation": {
      "additionalProperties": false,
      "description": "One 0-based breakpoint with cytoband, transcript and technical context.",
      "properties": {
        "chromosome": {
          "pattern": "^chr(?:[1-9]|1[0-9]|2[0-2]|X|Y|M)$",
          "title": "Chromosome",
          "type": "string"
        },
        "contexts": {
          "items": {
            "$ref": "#/$defs/BreakpointContextAnnotation"
          },
          "title": "Contexts",
          "type": "array"
        },
        "cytoband": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cytoband"
        },
        "label": {
          "enum": [
            "primary",
            "secondary"
          ],
          "title": "Label",
          "type": "string"
        },
        "position": {
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        },
        "transcripts": {
          "items": {
            "$ref": "#/$defs/BreakpointTranscriptAnnotation"
          },
          "title": "Transcripts",
          "type": "array"
        }
      },
      "required": [
        "label",
        "chromosome",
        "position"
      ],
      "title": "BreakpointAnnotation",
      "type": "object"
    },
    "BreakpointContextAnnotation": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "resource_type": {
          "minLength": 1,
          "title": "Resource Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "resource_type",
        "label"
      ],
      "title": "BreakpointContextAnnotation",
      "type": "object"
    },
    "BreakpointTranscriptAnnotation": {
      "additionalProperties": false,
      "description": "Transcript-level context for one independently annotated SV breakpoint.",
      "properties": {
        "cds_phase": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cds Phase"
        },
        "exon_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exon Number"
        },
        "gene_id": {
          "minLength": 1,
          "title": "Gene Id",
          "type": "string"
        },
        "gene_name": {
          "minLength": 1,
          "title": "Gene Name",
          "type": "string"
        },
        "intron_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intron Number"
        },
        "preferred": {
          "default": false,
          "title": "Preferred",
          "type": "boolean"
        },
        "rank_tier": {
          "minimum": 1,
          "title": "Rank Tier",
          "type": "integer"
        },
        "region": {
          "enum": [
            "exon",
            "intron",
            "transcript"
          ],
          "title": "Region",
          "type": "string"
        },
        "strand": {
          "enum": [
            "+",
            "-"
          ],
          "title": "Strand",
          "type": "string"
        },
        "transcript_id": {
          "minLength": 1,
          "title": "Transcript Id",
          "type": "string"
        },
        "transcript_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcript Name"
        }
      },
      "required": [
        "gene_id",
        "gene_name",
        "transcript_id",
        "strand",
        "rank_tier",
        "region"
      ],
      "title": "BreakpointTranscriptAnnotation",
      "type": "object"
    },
    "EventAnnotation": {
      "additionalProperties": false,
      "description": "A knowledge-base record attached to a finding \u2014 evidence, never a verdict.\n\nCarries the source's assertion verbatim together with the vocabulary it belongs to, so\nClinVar's germline *Pathogenic* cannot be read as a claim about a somatic finding. No\nfield here influences ``reportable`` or ``confidence``, and none may be added that does:\nthat decision needs somatic criteria this repository does not have.",
      "properties": {
        "assertion": {
          "title": "Assertion",
          "type": "string"
        },
        "assertion_vocabulary": {
          "minLength": 1,
          "title": "Assertion Vocabulary",
          "type": "string"
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        },
        "conditions": {
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "genes": {
          "items": {
            "type": "string"
          },
          "title": "Genes",
          "type": "array"
        },
        "match_type": {
          "enum": [
            "exact",
            "record_within_finding",
            "finding_within_record",
            "overlap"
          ],
          "title": "Match Type",
          "type": "string"
        },
        "reciprocal_overlap": {
          "maximum": 1,
          "minimum": 0,
          "title": "Reciprocal Overlap",
          "type": "number"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "record_origin": {
          "enum": [
            "germline",
            "somatic",
            "unknown"
          ],
          "title": "Record Origin",
          "type": "string"
        },
        "record_type": {
          "minLength": 1,
          "title": "Record Type",
          "type": "string"
        },
        "review_stars": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Stars"
        },
        "review_status": {
          "default": "",
          "title": "Review Status",
          "type": "string"
        },
        "scope_alignment": {
          "enum": [
            "aligned",
            "mismatched",
            "unknown"
          ],
          "title": "Scope Alignment",
          "type": "string"
        },
        "scope_note": {
          "title": "Scope Note",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_release": {
          "minLength": 1,
          "title": "Source Release",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_release",
        "source_sha256",
        "record_id",
        "record_type",
        "assertion",
        "assertion_vocabulary",
        "record_origin",
        "scope_alignment",
        "scope_note",
        "match_type",
        "reciprocal_overlap"
      ],
      "title": "EventAnnotation",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "chromosome_gain",
        "chromosome_loss",
        "deletion",
        "duplication",
        "inversion",
        "translocation",
        "insertion",
        "fusion"
      ],
      "title": "EventType",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "caller": {
          "title": "Caller",
          "type": "string"
        },
        "caller_version": {
          "title": "Caller Version",
          "type": "string"
        },
        "coverage_context": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "title": "Coverage Context",
          "type": "array"
        },
        "filters": {
          "items": {
            "type": "string"
          },
          "title": "Filters",
          "type": "array"
        },
        "length_standard_deviation": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Standard Deviation"
        },
        "local_coverage": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Coverage"
        },
        "mean_alignment_nm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Alignment Nm"
        },
        "position_standard_deviation": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position Standard Deviation"
        },
        "precise": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precise"
        },
        "quality": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality"
        },
        "support_reads": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Support Reads"
        },
        "supporting_read_strands": {
          "anyOf": [
            {
              "pattern": "^[+-]{1,2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supporting Read Strands"
        },
        "variant_allele_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Allele Fraction"
        }
      },
      "required": [
        "caller",
        "caller_version"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FusionAnnotation": {
      "additionalProperties": false,
      "properties": {
        "frame_status": {
          "default": "unknown",
          "enum": [
            "in_frame",
            "out_of_frame",
            "unknown"
          ],
          "title": "Frame Status",
          "type": "string"
        },
        "gene_a": {
          "$ref": "#/$defs/FusionPartnerAnnotation"
        },
        "gene_b": {
          "$ref": "#/$defs/FusionPartnerAnnotation"
        },
        "orientation": {
          "anyOf": [
            {
              "enum": [
                "++",
                "+-",
                "-+",
                "--"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orientation"
        }
      },
      "required": [
        "gene_a",
        "gene_b"
      ],
      "title": "FusionAnnotation",
      "type": "object"
    },
    "FusionPartnerAnnotation": {
      "additionalProperties": false,
      "properties": {
        "exon_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exon Number"
        },
        "gene": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gene"
        },
        "intron_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intron Number"
        },
        "preferred_transcript": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred Transcript"
        },
        "region": {
          "default": "unknown",
          "enum": [
            "exon",
            "intron",
            "transcript",
            "unknown"
          ],
          "title": "Region",
          "type": "string"
        },
        "strand": {
          "anyOf": [
            {
              "enum": [
                "+",
                "-"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strand"
        }
      },
      "title": "FusionPartnerAnnotation",
      "type": "object"
    },
    "FusionSupportStatus": {
      "enum": [
        "not_assessed",
        "fusion_candidate",
        "fusion_supported",
        "fusion_validated"
      ],
      "title": "FusionSupportStatus",
      "type": "string"
    },
    "GenomeBuild": {
      "enum": [
        "GRCh37",
        "GRCh38"
      ],
      "title": "GenomeBuild",
      "type": "string"
    },
    "GenomicEvent": {
      "additionalProperties": false,
      "properties": {
        "aml_relevance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aml Relevance"
        },
        "annotations": {
          "items": {
            "$ref": "#/$defs/EventAnnotation"
          },
          "title": "Annotations",
          "type": "array"
        },
        "breakpoint_annotations": {
          "items": {
            "$ref": "#/$defs/BreakpointAnnotation"
          },
          "title": "Breakpoint Annotations",
          "type": "array"
        },
        "breakpoint_distance_bp": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Breakpoint Distance Bp"
        },
        "breakpoint_mean_depths": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Breakpoint Mean Depths",
          "type": "array"
        },
        "confidence": {
          "default": "unclassified",
          "enum": [
            "high",
            "moderate",
            "low",
            "unclassified"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "copy_number": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Copy Number"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/EventType"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "fusion_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/FusionAnnotation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fusion_status": {
          "$ref": "#/$defs/FusionSupportStatus",
          "default": "not_assessed"
        },
        "genes": {
          "items": {
            "type": "string"
          },
          "title": "Genes",
          "type": "array"
        },
        "known_pathologies": {
          "items": {
            "$ref": "#/$defs/PathologyAssociation"
          },
          "title": "Known Pathologies",
          "type": "array"
        },
        "known_rearrangement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Rearrangement"
        },
        "length_bp": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Bp"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "observability": {
          "$ref": "#/$defs/SvObservability",
          "default": "NOT_APPLICABLE"
        },
        "observability_target_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetBedRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "primary": {
          "$ref": "#/$defs/Locus"
        },
        "reportable": {
          "default": false,
          "title": "Reportable",
          "type": "boolean"
        },
        "secondary": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Event Ids",
          "type": "array"
        },
        "technical_flags": {
          "items": {
            "type": "string"
          },
          "title": "Technical Flags",
          "type": "array"
        },
        "validation_status": {
          "$ref": "#/$defs/SvValidationStatus",
          "default": "detected"
        }
      },
      "required": [
        "event_id",
        "event_type",
        "primary"
      ],
      "title": "GenomicEvent",
      "type": "object"
    },
    "ISCNProposal": {
      "additionalProperties": false,
      "properties": {
        "conformance_profile": {
          "const": "subset-v0.1-unvalidated",
          "default": "subset-v0.1-unvalidated",
          "title": "Conformance Profile",
          "type": "string"
        },
        "notation": {
          "title": "Notation",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "REVIEW_REQUIRED"
        },
        "source_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Event Ids",
          "type": "array"
        },
        "standard_edition": {
          "const": "ISCN 2024",
          "default": "ISCN 2024",
          "title": "Standard Edition",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "notation"
      ],
      "title": "ISCNProposal",
      "type": "object"
    },
    "InputKind": {
      "enum": [
        "pod5",
        "unaligned_bam",
        "aligned_bam"
      ],
      "title": "InputKind",
      "type": "string"
    },
    "InputSpec": {
      "additionalProperties": false,
      "properties": {
        "index_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Path"
        },
        "kind": {
          "$ref": "#/$defs/InputKind"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "InputSpec",
      "type": "object"
    },
    "LegacyResourceContext": {
      "additionalProperties": false,
      "description": "Marker used when a PipelineResult 0.1 artifact had no bundle provenance.",
      "properties": {
        "status": {
