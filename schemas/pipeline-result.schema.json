          "default": false,
          "title": "Contains Direct Identifiers",
          "type": "boolean"
        },
        "pseudonymized": {
          "default": true,
          "title": "Pseudonymized",
          "type": "boolean"
        }
      },
      "title": "PrivacySpec",
      "type": "object"
    },
