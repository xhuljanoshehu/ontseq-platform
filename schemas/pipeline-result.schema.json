{
  "$defs": {
    "AnalysisIntent": {
      "description": "Whether this analysis is looking for acquired or inherited variation.\n\nLoad-bearing for knowledge-base annotation: ClinVar classifies germline variation under\nACMG rules, and an AML workup asks a somatic question. Pairing the two without saying so\npresents an inherited-disease classification as though it answered a question about a\ntumour.",
      "enum": [
        "somatic",
        "germline",
        "both"
      ],
      "title": "AnalysisIntent",
      "type": "string"
    },
    "AnalysisModule": {
      "enum": [
        "qc",
        "cnv",
        "sv",
        "fusion",
        "iscn",
        "report",
        "small_variants",
        "methylation"
      ],
      "title": "AnalysisModule",
      "type": "string"
    },
    "AnalysisSpec": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisIntent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "modules": {
          "items": {
            "$ref": "#/$defs/AnalysisModule"
          },
          "title": "Modules",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "profile": {
          "minLength": 1,
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "profile",
        "modules"
      ],
      "title": "AnalysisSpec",
      "type": "object"
    },
    "AssayMode": {
      "enum": [
        "lcwgs",
        "adaptive_sampling"
      ],
      "title": "AssayMode",
      "type": "string"
    },
    "AssaySpec": {
      "additionalProperties": false,
      "properties": {
        "genome_build": {
          "$ref": "#/$defs/GenomeBuild"
        },
        "mode": {
          "$ref": "#/$defs/AssayMode"
        },
        "reference_id": {
          "minLength": 1,
          "title": "Reference Id",
          "type": "string"
        },
        "target_bed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Bed"
        },
        "target_bed_role": {
          "$ref": "#/$defs/TargetBedRole",
          "default": "analysis_roi_unbuffered"
        },
        "target_bed_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Bed Version"
        }
      },
      "required": [
        "mode",
        "genome_build",
        "reference_id"
      ],
      "title": "AssaySpec",
      "type": "object"
    },
    "EventAnnotation": {
      "additionalProperties": false,
      "description": "A knowledge-base record attached to a finding \u2014 evidence, never a verdict.\n\nCarries the source's assertion verbatim together with the vocabulary it belongs to, so\nClinVar's germline *Pathogenic* cannot be read as a claim about a somatic finding. No\nfield here influences ``reportable`` or ``confidence``, and none may be added that does:\nthat decision needs somatic criteria this repository does not have.",
      "properties": {
        "assertion": {
          "title": "Assertion",
          "type": "string"
        },
        "assertion_vocabulary": {
          "minLength": 1,
          "title": "Assertion Vocabulary",
          "type": "string"
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        },
        "conditions": {
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "genes": {
          "items": {
            "type": "string"
          },
          "title": "Genes",
          "type": "array"
        },
        "match_type": {
          "enum": [
            "exact",
            "record_within_finding",
            "finding_within_record",
            "overlap"
          ],
          "title": "Match Type",
          "type": "string"
        },
        "reciprocal_overlap": {
          "maximum": 1,
          "minimum": 0,
          "title": "Reciprocal Overlap",
          "type": "number"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "record_origin": {
          "enum": [
            "germline",
            "somatic",
            "unknown"
          ],
          "title": "Record Origin",
          "type": "string"
        },
        "record_type": {
          "minLength": 1,
          "title": "Record Type",
          "type": "string"
        },
        "review_stars": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Stars"
        },
        "review_status": {
          "default": "",
          "title": "Review Status",
          "type": "string"
        },
        "scope_alignment": {
          "enum": [
            "aligned",
            "mismatched",
            "unknown"
          ],
          "title": "Scope Alignment",
          "type": "string"
        },
        "scope_note": {
          "title": "Scope Note",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_release": {
          "minLength": 1,
          "title": "Source Release",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_release",
        "source_sha256",
        "record_id",
        "record_type",
        "assertion",
        "assertion_vocabulary",
        "record_origin",
        "scope_alignment",
        "scope_note",
        "match_type",
        "reciprocal_overlap"
      ],
      "title": "EventAnnotation",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "chromosome_gain",
        "chromosome_loss",
        "deletion",
        "duplication",
        "inversion",
        "translocation",
        "insertion",
        "fusion"
      ],
      "title": "EventType",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "caller": {
          "title": "Caller",
          "type": "string"
        },
        "caller_version": {
          "title": "Caller Version",
          "type": "string"
        },
        "coverage_context": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "title": "Coverage Context",
          "type": "array"
        },
        "filters": {
          "items": {
            "type": "string"
          },
          "title": "Filters",
          "type": "array"
        },
        "length_standard_deviation": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Standard Deviation"
        },
        "local_coverage": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Coverage"
        },
        "mean_alignment_nm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Alignment Nm"
        },
        "position_standard_deviation": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position Standard Deviation"
        },
        "precise": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precise"
        },
        "quality": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality"
        },
        "support_reads": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Support Reads"
        },
        "supporting_read_strands": {
          "anyOf": [
            {
              "pattern": "^(?:\\+|-|\\+-)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supporting Read Strands"
        },
        "variant_allele_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Allele Fraction"
        }
      },
      "required": [
        "caller",
        "caller_version"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "GenomeBuild": {
      "enum": [
        "GRCh37",
        "GRCh38"
      ],
      "title": "GenomeBuild",
      "type": "string"
    },
    "GenomicEvent": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "items": {
            "$ref": "#/$defs/EventAnnotation"
          },
          "title": "Annotations",
          "type": "array"
        },
        "confidence": {
          "default": "unclassified",
          "enum": [
            "high",
            "moderate",
            "low",
            "unclassified"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "copy_number": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Copy Number"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/EventType"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "genes": {
          "items": {
            "type": "string"
          },
          "title": "Genes",
          "type": "array"
        },
        "length_bp": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Bp"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "primary": {
          "$ref": "#/$defs/Locus"
        },
        "reportable": {
          "default": false,
          "title": "Reportable",
          "type": "boolean"
        },
        "secondary": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "event_id",
        "event_type",
        "primary"
      ],
      "title": "GenomicEvent",
      "type": "object"
    },
    "ISCNProposal": {
      "additionalProperties": false,
      "properties": {
        "conformance_profile": {
          "const": "subset-v0.1-unvalidated",
          "default": "subset-v0.1-unvalidated",
          "title": "Conformance Profile",
          "type": "string"
        },
        "notation": {
          "title": "Notation",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "REVIEW_REQUIRED"
        },
        "source_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Event Ids",
          "type": "array"
        },
        "standard_edition": {
          "const": "ISCN 2024",
          "default": "ISCN 2024",
          "title": "Standard Edition",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "notation"
      ],
      "title": "ISCNProposal",
      "type": "object"
    },
    "InputKind": {
      "enum": [
        "pod5",
        "unaligned_bam",
        "aligned_bam"
      ],
      "title": "InputKind",
      "type": "string"
    },
    "InputSpec": {
      "additionalProperties": false,
      "properties": {
        "index_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Path"
        },
        "kind": {
          "$ref": "#/$defs/InputKind"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "InputSpec",
      "type": "object"
    },
    "Locus": {
      "additionalProperties": false,
      "properties": {
        "chromosome": {
          "pattern": "^(?:chr)?(?:[1-9]|1[0-9]|2[0-2]|X|Y)$",
          "title": "Chromosome",
          "type": "string"
        },
        "cytoband_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cytoband End"
        },
        "cytoband_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cytoband Start"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "gene": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gene"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "chromosome",
        "start",
        "end"
      ],
      "title": "Locus",
      "type": "object"
    },
    "ModuleOutcome": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "$ref": "#/$defs/AnalysisModule"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ModuleRunStatus"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolRecord"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "module",
        "status",
        "reason"
      ],
      "title": "ModuleOutcome",
      "type": "object"
    },
    "ModuleRunStatus": {
      "enum": [
        "COMPLETED",
        "NOT_RUN",
        "FAILED",
        "NO_CALL"
      ],
      "title": "ModuleRunStatus",
      "type": "string"
    },
    "PrivacySpec": {
      "additionalProperties": false,
      "properties": {
        "cloud_upload_approved": {
          "default": false,
          "title": "Cloud Upload Approved",
          "type": "boolean"
        },
        "contains_direct_identifiers": {
          "default": false,
          "title": "Contains Direct Identifiers",
          "type": "boolean"
        },
        "pseudonymized": {
          "default": true,
          "title": "Pseudonymized",
          "type": "boolean"
        }
      },
      "title": "PrivacySpec",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "git_commit": {
          "title": "Git Commit",
          "type": "string"
        },
        "pipeline_version": {
          "title": "Pipeline Version",
          "type": "string"
        },
        "reference_checksums": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Reference Checksums",
          "type": "object"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolRecord"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "pipeline_version",
        "git_commit"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "QCMetrics": {
      "additionalProperties": false,
      "properties": {
        "failed_gates": {
          "items": {
            "type": "string"
          },
          "title": "Failed Gates",
          "type": "array"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "verdict",
        "metrics"
      ],
      "title": "QCMetrics",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "DRAFT",
        "REVIEW_REQUIRED",
        "REVIEWED"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "SampleManifest": {
      "additionalProperties": false,
      "properties": {
        "analysis": {
          "$ref": "#/$defs/AnalysisSpec"
        },
        "assay": {
          "$ref": "#/$defs/AssaySpec"
        },
        "input": {
          "$ref": "#/$defs/InputSpec"
        },
        "privacy": {
          "$ref": "#/$defs/PrivacySpec"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "sample_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$",
          "title": "Sample Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "run_id",
        "input",
        "assay",
        "analysis"
      ],
      "title": "SampleManifest",
      "type": "object"
    },
    "TargetBedRole": {
      "description": "What a target BED actually is. The two are not interchangeable.\n\nThe BED a sequencer selects on usually carries flanks so that a read starting outside a\ngene is still enriched. Coverage computed over that buffered design answers \"was the\nenrichment working\"; it does not answer \"was the analysis region observed\", because the\nflanks dilute the per-target mean. Reporting one as the other overstates or understates\nadequacy depending on the flank size, so the manifest has to say which one it points at.",
      "enum": [
        "analysis_roi_unbuffered",
        "selection_panel_buffered"
      ],
      "title": "TargetBedRole",
      "type": "string"
    },
    "ToolRecord": {
      "additionalProperties": false,
      "properties": {
        "container_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Digest"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ToolRecord",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "NOT_RUN"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "events": {
      "items": {
        "$ref": "#/$defs/GenomicEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "iscn": {
      "$ref": "#/$defs/ISCNProposal"
    },
    "manifest": {
      "$ref": "#/$defs/SampleManifest"
    },
    "modules": {
      "items": {
        "$ref": "#/$defs/ModuleOutcome"
      },
      "title": "Modules",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "qc": {
      "$ref": "#/$defs/QCMetrics"
    },
    "release_status": {
      "$ref": "#/$defs/ReviewStatus",
      "default": "REVIEW_REQUIRED"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "manifest",
    "qc",
    "events",
    "iscn",
    "provenance"
  ],
  "title": "PipelineResult",
  "type": "object"
}
