{
  "$defs": {
    "AnalysisIntent": {
      "description": "Whether this analysis is looking for acquired or inherited variation.\n\nLoad-bearing for knowledge-base annotation: ClinVar classifies germline variation under\nACMG rules, and an AML workup asks a somatic question. Pairing the two without saying so\npresents an inherited-disease classification as though it answered a question about a\ntumour.",
      "enum": [
        "somatic",
        "germline",
        "both"
      ],
      "title": "AnalysisIntent",
      "type": "string"
    },
    "AnalysisModule": {
      "enum": [
        "qc",
        "cnv",
        "sv",
        "fusion",
        "iscn",
        "report",
        "small_variants",
        "methylation"
      ],
      "title": "AnalysisModule",
      "type": "string"
    },
    "AnalysisSpec": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisIntent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "modules": {
          "items": {
            "$ref": "#/$defs/AnalysisModule"
          },
          "title": "Modules",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "profile": {
          "minLength": 1,
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "profile",
        "modules"
      ],
      "title": "AnalysisSpec",
      "type": "object"
    },
    "ArtifactRecord": {
      "additionalProperties": false,
      "description": "A checksummed artifact, addressed relative to the run envelope.",
      "properties": {
        "exportable": {
          "title": "Exportable",
          "type": "boolean"
        },
        "relative_path": {
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "size_bytes",
        "sha256",
        "exportable"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    },
    "AssayMode": {
      "enum": [
        "lcwgs",
        "adaptive_sampling"
      ],
      "title": "AssayMode",
      "type": "string"
    },
    "AssaySpec": {
      "additionalProperties": false,
      "properties": {
        "genome_build": {
          "$ref": "#/$defs/GenomeBuild"
        },
        "mode": {
          "$ref": "#/$defs/AssayMode"
        },
        "reference_id": {
          "minLength": 1,
          "title": "Reference Id",
          "type": "string"
        },
        "target_bed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Bed"
        },
        "target_bed_role": {
          "$ref": "#/$defs/TargetBedRole",
          "default": "analysis_roi_unbuffered"
        },
        "target_bed_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Bed Version"
        }
      },
      "required": [
        "mode",
        "genome_build",
        "reference_id"
      ],
      "title": "AssaySpec",
      "type": "object"
    },
    "GenomeBuild": {
      "enum": [
        "GRCh37",
        "GRCh38"
      ],
      "title": "GenomeBuild",
      "type": "string"
    },
    "InputKind": {
      "enum": [
        "pod5",
        "unaligned_bam",
        "aligned_bam"
      ],
      "title": "InputKind",
      "type": "string"
    },
    "InputSpec": {
      "additionalProperties": false,
      "properties": {
        "index_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Path"
        },
        "kind": {
          "$ref": "#/$defs/InputKind"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "InputSpec",
      "type": "object"
    },
    "ModuleRunStatus": {
      "enum": [
        "COMPLETED",
        "NOT_RUN",
        "FAILED",
        "NO_CALL"
      ],
      "title": "ModuleRunStatus",
      "type": "string"
    },
    "PrivacySpec": {
      "additionalProperties": false,
      "properties": {
        "cloud_upload_approved": {
          "default": false,
          "title": "Cloud Upload Approved",
          "type": "boolean"
        },
        "contains_direct_identifiers": {
          "default": false,
          "title": "Contains Direct Identifiers",
          "type": "boolean"
        },
        "pseudonymized": {
          "default": true,
          "title": "Pseudonymized",
          "type": "boolean"
        }
      },
      "title": "PrivacySpec",
      "type": "object"
    },
    "SampleManifest": {
      "additionalProperties": false,
      "properties": {
        "analysis": {
          "$ref": "#/$defs/AnalysisSpec"
        },
        "assay": {
          "$ref": "#/$defs/AssaySpec"
        },
        "input": {
          "$ref": "#/$defs/InputSpec"
        },
        "privacy": {
          "$ref": "#/$defs/PrivacySpec"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "sample_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$",
          "title": "Sample Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "run_id",
        "input",
        "assay",
        "analysis"
      ],
      "title": "SampleManifest",
      "type": "object"
    },
    "StageId": {
      "description": "Every stage the pipeline knows about.",
      "enum": [
        "basecall",
        "align",
        "intake",
        "qc",
        "target_coverage",
        "cnv",
        "sv",
        "assemble",
        "report",
        "release"
      ],
      "title": "StageId",
      "type": "string"
    },
    "StageRecord": {
      "additionalProperties": false,
      "description": "Outcome of one stage.",
      "properties": {
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/ArtifactRecord"
          },
          "title": "Outputs",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "resumed": {
          "default": false,
          "title": "Resumed",
          "type": "boolean"
        },
        "signature": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature"
        },
        "stage": {
          "$ref": "#/$defs/StageId"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "$ref": "#/$defs/ModuleRunStatus"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolRecord"
          },
          "title": "Tools",
          "type": "array"
        },
        "verification": {
          "$ref": "#/$defs/VerificationStatus"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "stage",
        "title",
        "status",
        "verification",
        "required",
        "reason"
      ],
      "title": "StageRecord",
      "type": "object"
    },
    "TargetBedRole": {
      "description": "What a target BED actually is. The two are not interchangeable.\n\nThe BED a sequencer selects on usually carries flanks so that a read starting outside a\ngene is still enriched. Coverage computed over that buffered design answers \"was the\nenrichment working\"; it does not answer \"was the analysis region observed\", because the\nflanks dilute the per-target mean. Reporting one as the other overstates or understates\nadequacy depending on the flank size, so the manifest has to say which one it points at.",
      "enum": [
        "analysis_roi_unbuffered",
        "selection_panel_buffered"
      ],
      "title": "TargetBedRole",
      "type": "string"
    },
    "ToolRecord": {
      "additionalProperties": false,
      "properties": {
        "container_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Digest"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ToolRecord",
      "type": "object"
    },
    "VerificationStatus": {
      "description": "How much confidence the *adapter* itself has earned.\n\nThis is not about scientific validity, which no stage in this repository has. It is\nthe narrower engineering question of whether the code has ever been executed against\nthe real tool.",
      "enum": [
        "verified_with_real_tool",
        "verified_pure_python",
        "unverified_adapter",
        "not_implemented"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The complete execution record of one run.",
  "properties": {
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "genome_build": {
      "$ref": "#/$defs/GenomeBuild"
    },
    "git_commit": {
      "title": "Git Commit",
      "type": "string"
    },
    "input_kind": {
      "$ref": "#/$defs/InputKind"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "manifest": {
      "$ref": "#/$defs/SampleManifest"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "pipeline_version": {
      "title": "Pipeline Version",
      "type": "string"
    },
    "research_only": {
      "const": true,
      "default": true,
      "title": "Research Only",
      "type": "boolean"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "sample_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$",
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageRecord"
      },
      "minItems": 1,
      "title": "Stages",
      "type": "array"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "unverified_stages": {
      "items": {
        "$ref": "#/$defs/StageId"
      },
      "title": "Unverified Stages",
      "type": "array"
    },
    "verdict_reason": {
      "minLength": 1,
      "title": "Verdict Reason",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "sample_id",
    "input_kind",
    "genome_build",
    "manifest",
    "passed",
    "verdict_reason",
    "stages",
    "pipeline_version",
    "git_commit",
    "started_at",
    "finished_at"
  ],
  "title": "RunReport",
  "type": "object"
}
