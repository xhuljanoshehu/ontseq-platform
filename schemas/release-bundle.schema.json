{
  "$defs": {
    "ArtifactRecord": {
      "additionalProperties": false,
      "description": "A checksummed artifact, addressed relative to the run envelope.",
      "properties": {
        "exportable": {
          "title": "Exportable",
          "type": "boolean"
        },
        "relative_path": {
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "size_bytes",
        "sha256",
        "exportable"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An immutable, verifiable inventory of a run's exportable artifacts.\n\nNon-exportable artifacts are listed by path and deliberately carry no checksum: the\nbundle documents that intermediate data existed and stayed behind, without becoming a\nvehicle for moving it.\n\nSigning is not performed here. An unsigned bundle that says so is honest; a bundle\nwith a fabricated signature field would not be.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRecord"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "git_commit": {
      "title": "Git Commit",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "pipeline_version": {
      "title": "Pipeline Version",
      "type": "string"
    },
    "release_status": {
      "const": "REVIEW_REQUIRED",
      "default": "REVIEW_REQUIRED",
      "title": "Release Status",
      "type": "string"
    },
    "research_only": {
      "const": true,
      "default": true,
      "title": "Research Only",
      "type": "boolean"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "run_report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Report Sha256",
      "type": "string"
    },
    "sample_id": {
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature_note": {
      "default": "This bundle is unsigned. Electronic signature requires an authorised key, a named responsible person and institutional change control.",
      "title": "Signature Note",
      "type": "string"
    },
    "signature_status": {
      "const": "unsigned",
      "default": "unsigned",
      "title": "Signature Status",
      "type": "string"
    },
    "total_bytes": {
      "minimum": 0,
      "title": "Total Bytes",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "withheld_artifact_paths": {
      "items": {
        "type": "string"
      },
      "title": "Withheld Artifact Paths",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "sample_id",
    "pipeline_version",
    "git_commit",
    "run_report_sha256",
    "artifacts",
    "total_bytes"
  ],
  "title": "ReleaseBundle",
  "type": "object"
}
