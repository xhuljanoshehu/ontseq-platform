{
  "$defs": {
    "CnvDataBasis": {
      "description": "Which reads a copy-number estimate was derived from.\n\nAdaptive sampling produces two very different read populations in one run. Rejected\nreads still occupy the flow cell and **may** form a near-uniform low-coverage\nwhole-genome background \u2014 the population most depth-based CNV methods assume \u2014 but\nwhether they do so on any particular assay is an open empirical question, not a\nproperty this code has measured. On-target reads are deeply but non-uniformly enriched\nand violate that assumption. Mixing the two in one benchmark stratum compares\nincomparable things, which is why the distinction is recorded whichever way the\nmeasurement eventually comes out.",
      "enum": [
        "adaptive_sampling_off_target",
        "adaptive_sampling_on_target",
        "adaptive_sampling_combined",
        "low_coverage_wgs",
        "whole_genome",
        "simulated"
      ],
      "title": "CnvDataBasis",
      "type": "string"
    },
    "CnvSegment": {
      "additionalProperties": false,
      "description": "One contiguous copy-number call or truth interval.\n\nCoordinates are zero-based half-open, matching BED. Several quantitative fields are\noptional because different methods report on different scales; the evaluator uses\n``state`` for agreement and ``copy_number`` for quantitative error, and simply\nreports fewer metrics when a field is absent rather than imputing one.",
      "properties": {
        "b_allele_frequency": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "B Allele Frequency"
        },
        "cellular_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cellular Fraction"
        },
        "contig": {
          "pattern": "^(?:chr)?(?:[1-9]|1[0-9]|2[0-2]|X|Y)$",
          "title": "Contig",
          "type": "string"
        },
        "copy_number": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Copy Number"
        },
        "copy_ratio": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Copy Ratio"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "end_uncertainty_bp": {
          "default": 0,
          "minimum": 0,
          "title": "End Uncertainty Bp",
          "type": "integer"
        },
        "log2_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Log2 Ratio"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "quality": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "start_uncertainty_bp": {
          "default": 0,
          "minimum": 0,
          "title": "Start Uncertainty Bp",
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/CopyNumberState"
        },
        "supporting_bins": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supporting Bins"
        }
      },
      "required": [
        "contig",
        "start",
        "end",
        "state"
      ],
      "title": "CnvSegment",
      "type": "object"
    },
    "CopyNumberState": {
      "description": "Per-base copy-number state.\n\n``NO_CALL`` is a first-class state and never a synonym for ``NEUTRAL``. A region a\nmethod could not assess must stay distinguishable from a region it assessed and\nfound unchanged, otherwise sensitivity and specificity are both unmeasurable.",
      "enum": [
        "homozygous_loss",
        "loss",
        "neutral",
        "gain",
        "high_amplification",
        "copy_neutral_loh",
        "no_call"
      ],
      "title": "CopyNumberState",
      "type": "string"
    },
    "GenomeBuild": {
      "enum": [
        "GRCh37",
        "GRCh38"
      ],
      "title": "GenomeBuild",
      "type": "string"
    },
    "GenomicRegion": {
      "additionalProperties": false,
      "description": "A plain interval used for scopes, exclusions and informative regions.",
      "properties": {
        "contig": {
          "pattern": "^(?:chr)?(?:[1-9]|1[0-9]|2[0-2]|X|Y)$",
          "title": "Contig",
          "type": "string"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "contig",
        "start",
        "end"
      ],
      "title": "GenomicRegion",
      "type": "object"
    },
    "ModuleRunStatus": {
      "enum": [
        "COMPLETED",
        "NOT_RUN",
        "FAILED",
        "NO_CALL"
      ],
      "title": "ModuleRunStatus",
      "type": "string"
    },
    "ToolRecord": {
      "additionalProperties": false,
      "properties": {
        "container_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Digest"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ToolRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Normalized output of one CNV method for one sample.",
  "properties": {
    "background_state": {
      "enum": [
        "neutral",
        "no_call"
      ],
      "title": "Background State",
      "type": "string"
    },
    "bin_size_bp": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bin Size Bp"
    },
    "call_set_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$",
      "title": "Call Set Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_basis": {
      "$ref": "#/$defs/CnvDataBasis"
    },
    "estimated_ploidy": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Ploidy"
    },
    "estimated_tumor_fraction": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Tumor Fraction"
    },
    "genome_build": {
      "$ref": "#/$defs/GenomeBuild"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "mean_coverage_x": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mean Coverage X"
    },
    "method": {
      "minLength": 1,
      "title": "Method",
      "type": "string"
    },
    "method_version": {
      "minLength": 1,
      "title": "Method Version",
      "type": "string"
    },
    "no_call_regions": {
      "items": {
        "$ref": "#/$defs/GenomicRegion"
      },
      "title": "No Call Regions",
      "type": "array"
    },
    "reportable": {
      "const": false,
      "default": false,
      "title": "Reportable",
      "type": "boolean"
    },
    "reports_biological_negative": {
      "default": false,
      "title": "Reports Biological Negative",
      "type": "boolean"
    },
    "research_only": {
      "const": true,
      "default": true,
      "title": "Research Only",
      "type": "boolean"
    },
    "sample_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$",
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/CnvSegment"
      },
      "title": "Segments",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ModuleRunStatus"
    },
    "tool": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "call_set_id",
    "sample_id",
    "genome_build",
    "method",
    "method_version",
    "data_basis",
    "background_state",
    "status"
  ],
  "title": "CnvCallSet",
  "type": "object"
}
