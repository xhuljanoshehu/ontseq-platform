{
  "additionalProperties": false,
  "properties": {
    "expected_samtools_version": {
      "default": "1.24",
      "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$",
      "title": "Expected Samtools Version",
      "type": "string"
    },
    "include_normal_only_control": {
      "default": true,
      "title": "Include Normal Only Control",
      "type": "boolean"
    },
    "note": {
      "minLength": 1,
      "title": "Note",
      "type": "string"
    },
    "observed_fraction_tolerance": {
      "default": 0.02,
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Observed Fraction Tolerance",
      "type": "number"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "replicates": {
      "default": 1,
      "minimum": 1,
      "title": "Replicates",
      "type": "integer"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "default": 42,
      "maximum": 999999,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "status": {
      "enum": [
        "technical_defaults_only",
        "validated"
      ],
      "title": "Status",
      "type": "string"
    },
    "total_read_target": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Read Target"
    },
    "tumor_fractions": {
      "items": {
        "type": "number"
      },
      "minItems": 1,
      "title": "Tumor Fractions",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "status",
    "note"
  ],
  "title": "DilutionPolicy",
  "type": "object"
}
