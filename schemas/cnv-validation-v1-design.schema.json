  "required": [
    "design_id",
    "coverage_levels_x",
    "tumor_fractions",
    "subchromosomal_sizes_bp",
    "replicates",
    "seed",
    "reference_id",
    "reference_sha256",
    "truth_source_resource_id",
    "truth_source_sha256",
    "assessability_resource_id",
    "assessability_sha256"
