{
  "$defs": {
    "Cytoband": {
      "additionalProperties": false,
      "description": "One banding interval.",
      "properties": {
        "contig": {
          "pattern": "^(?:chr)?(?:[1-9]|1[0-9]|2[0-2]|X|Y)$",
          "title": "Contig",
          "type": "string"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "stain": {
          "minLength": 1,
          "title": "Stain",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "contig",
        "start",
        "end",
        "name",
        "stain"
      ],
      "title": "Cytoband",
      "type": "object"
    },
    "GenomeBuild": {
      "enum": [
        "GRCh37",
        "GRCh38"
      ],
      "title": "GenomeBuild",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A checksummed, build-specific set of cytobands.",
  "properties": {
    "bands": {
      "items": {
        "$ref": "#/$defs/Cytoband"
      },
      "minItems": 1,
      "title": "Bands",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "genome_build": {
      "$ref": "#/$defs/GenomeBuild"
    },
    "resource_id": {
      "minLength": 1,
      "title": "Resource Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "source_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Sha256"
    }
  },
  "required": [
    "resource_id",
    "genome_build",
    "source",
    "bands"
  ],
  "title": "CytobandTable",
  "type": "object"
}
