{
  "$defs": {
    "AnalysisIntent": {
      "description": "Whether this analysis is looking for acquired or inherited variation.\n\nLoad-bearing for knowledge-base annotation: ClinVar classifies germline variation under\nACMG rules, and an AML workup asks a somatic question. Pairing the two without saying so\npresents an inherited-disease classification as though it answered a question about a\ntumour.",
      "enum": [
        "somatic",
        "germline",
        "both"
      ],
      "title": "AnalysisIntent",
      "type": "string"
    },
    "AnalysisModule": {
      "enum": [
        "qc",
        "cnv",
        "sv",
        "fusion",
        "iscn",
        "report",
        "small_variants",
        "methylation"
      ],
      "title": "AnalysisModule",
      "type": "string"
    },
    "AnalysisSpec": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisIntent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "modules": {
          "items": {
            "$ref": "#/$defs/AnalysisModule"
          },
          "title": "Modules",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "profile": {
          "minLength": 1,
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "profile",
        "modules"
      ],
      "title": "AnalysisSpec",
      "type": "object"
    },
    "AssayMode": {
      "enum": [
        "lcwgs",
        "adaptive_sampling"
      ],
      "title": "AssayMode",
      "type": "string"
    },
    "AssaySpec": {
      "additionalProperties": false,
      "properties": {
        "genome_build": {
          "$ref": "#/$defs/GenomeBuild"
        },
        "mode": {
          "$ref": "#/$defs/AssayMode"
        },
        "reference_id": {
          "minLength": 1,
          "title": "Reference Id",
          "type": "string"
        },
        "target_bed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Bed"
        },
        "target_bed_role": {
          "$ref": "#/$defs/TargetBedRole",
          "default": "analysis_roi_unbuffered"
        },
        "target_bed_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Bed Version"
        }
      },
      "required": [
        "mode",
        "genome_build",
        "reference_id"
      ],
      "title": "AssaySpec",
      "type": "object"
    },
    "GenomeBuild": {
      "enum": [
        "GRCh37",
        "GRCh38"
      ],
      "title": "GenomeBuild",
      "type": "string"
    },
    "InputKind": {
      "enum": [
        "pod5",
        "unaligned_bam",
        "aligned_bam"
      ],
      "title": "InputKind",
      "type": "string"
    },
    "InputSpec": {
      "additionalProperties": false,
      "properties": {
        "index_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Path"
        },
        "kind": {
          "$ref": "#/$defs/InputKind"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "InputSpec",
      "type": "object"
    },
    "PrivacySpec": {
      "additionalProperties": false,
      "properties": {
        "cloud_upload_approved": {
          "default": false,
          "title": "Cloud Upload Approved",
          "type": "boolean"
        },
        "contains_direct_identifiers": {
          "default": false,
          "title": "Contains Direct Identifiers",
          "type": "boolean"
        },
        "pseudonymized": {
          "default": true,
          "title": "Pseudonymized",
          "type": "boolean"
        }
      },
      "title": "PrivacySpec",
      "type": "object"
    },
    "TargetBedRole": {
      "description": "What a target BED actually is. The two are not interchangeable.\n\nThe BED a sequencer selects on usually carries flanks so that a read starting outside a\ngene is still enriched. Coverage computed over that buffered design answers \"was the\nenrichment working\"; it does not answer \"was the analysis region observed\", because the\nflanks dilute the per-target mean. Reporting one as the other overstates or understates\nadequacy depending on the flank size, so the manifest has to say which one it points at.",
      "enum": [
        "analysis_roi_unbuffered",
        "selection_panel_buffered"
      ],
      "title": "TargetBedRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis": {
      "$ref": "#/$defs/AnalysisSpec"
    },
    "assay": {
      "$ref": "#/$defs/AssaySpec"
    },
    "input": {
      "$ref": "#/$defs/InputSpec"
    },
    "privacy": {
      "$ref": "#/$defs/PrivacySpec"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "sample_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$",
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "sample_id",
    "run_id",
    "input",
    "assay",
    "analysis"
  ],
  "title": "SampleManifest",
  "type": "object"
}
