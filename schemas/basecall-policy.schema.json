{
  "additionalProperties": false,
  "description": "Version- and model-locked basecalling configuration.",
  "properties": {
    "device": {
      "default": "cuda:all",
      "minLength": 1,
      "title": "Device",
      "type": "string"
    },
    "emit_moves": {
      "default": false,
      "title": "Emit Moves",
      "type": "boolean"
    },
    "expected_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Expected Version",
      "type": "string"
    },
    "minimum_qscore": {
      "anyOf": [
        {
          "maximum": 60,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum Qscore"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "model_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Sha256"
    },
    "modified_bases": {
      "items": {
        "type": "string"
      },
      "title": "Modified Bases",
      "type": "array"
    },
    "note": {
      "minLength": 1,
      "title": "Note",
      "type": "string"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "technical_defaults_only",
        "validated"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "profile_id",
    "status",
    "expected_version",
    "model",
    "note"
  ],
  "title": "BasecallPolicy",
  "type": "object"
}
