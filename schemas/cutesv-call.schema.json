{
  "$defs": {
    "CuteSvPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed_sv_types": {
          "items": {
            "$ref": "#/$defs/EventType"
          },
          "minItems": 1,
          "title": "Allowed Sv Types",
          "type": "array"
        },
        "diff_ratio_merging_del": {
          "default": 0.3,
          "maximum": 1,
          "minimum": 0,
          "title": "Diff Ratio Merging Del",
          "type": "number"
        },
        "diff_ratio_merging_ins": {
          "default": 0.3,
          "maximum": 1,
          "minimum": 0,
          "title": "Diff Ratio Merging Ins",
          "type": "number"
        },
        "expected_version": {
          "default": "2.1.3",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Expected Version",
          "type": "string"
        },
        "max_cluster_bias_del": {
          "default": 100,
          "minimum": 0,
          "title": "Max Cluster Bias Del",
          "type": "integer"
        },
        "max_cluster_bias_ins": {
          "default": 100,
          "minimum": 0,
          "title": "Max Cluster Bias Ins",
          "type": "integer"
        },
        "min_support": {
          "default": 5,
          "minimum": 1,
          "title": "Min Support",
          "type": "integer"
        },
        "min_sv_length": {
          "default": 50,
          "minimum": 1,
          "title": "Min Sv Length",
          "type": "integer"
        },
        "minimum_quality": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Quality"
        },
        "note": {
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "pass_only": {
          "const": true,
          "default": true,
          "title": "Pass Only",
          "type": "boolean"
        },
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "technical_defaults_only",
            "validated"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "status",
        "note"
      ],
      "title": "CuteSvPolicy",
      "type": "object"
    },
    "EventAnnotation": {
      "additionalProperties": false,
      "description": "A knowledge-base record attached to a finding \u2014 evidence, never a verdict.\n\nCarries the source's assertion verbatim together with the vocabulary it belongs to, so\nClinVar's germline *Pathogenic* cannot be read as a claim about a somatic finding. No\nfield here influences ``reportable`` or ``confidence``, and none may be added that does:\nthat decision needs somatic criteria this repository does not have.",
      "properties": {
        "assertion": {
          "title": "Assertion",
          "type": "string"
        },
        "assertion_vocabulary": {
          "minLength": 1,
          "title": "Assertion Vocabulary",
          "type": "string"
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        },
        "conditions": {
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "genes": {
          "items": {
            "type": "string"
          },
          "title": "Genes",
          "type": "array"
        },
        "match_type": {
          "enum": [
            "exact",
            "record_within_finding",
            "finding_within_record",
            "overlap"
          ],
          "title": "Match Type",
          "type": "string"
        },
        "reciprocal_overlap": {
          "maximum": 1,
          "minimum": 0,
          "title": "Reciprocal Overlap",
          "type": "number"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "record_origin": {
          "enum": [
            "germline",
            "somatic",
            "unknown"
          ],
          "title": "Record Origin",
          "type": "string"
        },
        "record_type": {
          "minLength": 1,
          "title": "Record Type",
          "type": "string"
        },
        "review_stars": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Stars"
        },
        "review_status": {
          "default": "",
          "title": "Review Status",
          "type": "string"
        },
        "scope_alignment": {
          "enum": [
            "aligned",
            "mismatched",
            "unknown"
          ],
          "title": "Scope Alignment",
          "type": "string"
        },
        "scope_note": {
          "title": "Scope Note",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_release": {
          "minLength": 1,
          "title": "Source Release",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_release",
        "source_sha256",
        "record_id",
        "record_type",
        "assertion",
        "assertion_vocabulary",
        "record_origin",
        "scope_alignment",
        "scope_note",
        "match_type",
        "reciprocal_overlap"
      ],
      "title": "EventAnnotation",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "chromosome_gain",
        "chromosome_loss",
        "deletion",
        "duplication",
        "inversion",
        "translocation",
        "insertion",
        "fusion"
      ],
      "title": "EventType",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "caller": {
          "title": "Caller",
          "type": "string"
        },
        "caller_version": {
          "title": "Caller Version",
          "type": "string"
        },
        "coverage_context": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "title": "Coverage Context",
          "type": "array"
        },
        "filters": {
          "items": {
            "type": "string"
          },
          "title": "Filters",
          "type": "array"
        },
        "length_standard_deviation": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Standard Deviation"
        },
        "local_coverage": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Coverage"
        },
        "mean_alignment_nm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Alignment Nm"
        },
        "position_standard_deviation": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position Standard Deviation"
        },
        "precise": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precise"
        },
        "quality": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality"
        },
        "support_reads": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Support Reads"
        },
        "supporting_read_strands": {
          "anyOf": [
            {
              "pattern": "^[+-]{1,2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supporting Read Strands"
        },
        "variant_allele_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Allele Fraction"
        }
      },
      "required": [
        "caller",
        "caller_version"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FileFingerprint": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "size_bytes"
      ],
      "title": "FileFingerprint",
      "type": "object"
    },
    "FusionSupportStatus": {
      "enum": [
        "not_assessed",
        "fusion_candidate",
        "fusion_supported",
        "fusion_validated"
      ],
      "title": "FusionSupportStatus",
      "type": "string"
    },
    "GenomeBuild": {
      "enum": [
        "GRCh37",
        "GRCh38"
      ],
      "title": "GenomeBuild",
      "type": "string"
    },
    "GenomicEvent": {
      "additionalProperties": false,
      "properties": {
        "aml_relevance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aml Relevance"
        },
        "annotations": {
          "items": {
            "$ref": "#/$defs/EventAnnotation"
          },
          "title": "Annotations",
          "type": "array"
        },
        "breakpoint_distance_bp": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Breakpoint Distance Bp"
        },
        "breakpoint_mean_depths": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Breakpoint Mean Depths",
          "type": "array"
        },
        "confidence": {
          "default": "unclassified",
          "enum": [
            "high",
            "moderate",
            "low",
            "unclassified"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "copy_number": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Copy Number"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/EventType"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "fusion_status": {
          "$ref": "#/$defs/FusionSupportStatus",
          "default": "not_assessed"
        },
        "genes": {
          "items": {
            "type": "string"
          },
          "title": "Genes",
          "type": "array"
        },
        "known_rearrangement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Rearrangement"
        },
        "length_bp": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Bp"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "observability": {
          "$ref": "#/$defs/SvObservability",
          "default": "NOT_APPLICABLE"
        },
        "observability_target_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetBedRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "primary": {
          "$ref": "#/$defs/Locus"
        },
        "reportable": {
          "default": false,
          "title": "Reportable",
          "type": "boolean"
        },
        "secondary": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Event Ids",
          "type": "array"
        },
        "technical_flags": {
          "items": {
            "type": "string"
          },
          "title": "Technical Flags",
          "type": "array"
        },
        "validation_status": {
          "$ref": "#/$defs/SvValidationStatus",
          "default": "detected"
        }
      },
      "required": [
        "event_id",
        "event_type",
        "primary"
      ],
      "title": "GenomicEvent",
      "type": "object"
    },
    "Locus": {
      "additionalProperties": false,
      "properties": {
        "chromosome": {
          "pattern": "^(?:chr)?(?:[1-9]|1[0-9]|2[0-2]|X|Y)$",
          "title": "Chromosome",
          "type": "string"
        },
        "cytoband_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cytoband End"
        },
        "cytoband_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cytoband Start"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "gene": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gene"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "chromosome",
        "start",
        "end"
      ],
      "title": "Locus",
      "type": "object"
    },
    "ModuleRunStatus": {
      "enum": [
        "COMPLETED",
        "NOT_RUN",
        "FAILED",
        "NO_CALL"
      ],
      "title": "ModuleRunStatus",
      "type": "string"
    },
    "SvObservability": {
      "enum": [
        "OBSERVED_ADEQUATELY",
        "PARTIALLY_OBSERVED",
        "INSUFFICIENT_COVERAGE",
        "OUTSIDE_TARGET",
        "NOT_APPLICABLE"
      ],
      "title": "SvObservability",
      "type": "string"
    },
    "SvValidationStatus": {
      "enum": [
        "detected",
        "technically_supported",
        "biologically_prioritized",
        "analytically_validated",
        "reportable"
      ],
      "title": "SvValidationStatus",
      "type": "string"
    },
    "TargetBedRole": {
      "description": "What a target BED actually is. The two are not interchangeable.\n\nThe BED a sequencer selects on usually carries flanks so that a read starting outside a\ngene is still enriched. Coverage computed over that buffered design answers \"was the\nenrichment working\"; it does not answer \"was the analysis region observed\", because the\nflanks dilute the per-target mean. Reporting one as the other overstates or understates\nadequacy depending on the flank size, so the manifest has to say which one it points at.",
      "enum": [
        "analysis_roi_unbuffered",
        "selection_panel_buffered"
      ],
      "title": "TargetBedRole",
      "type": "string"
    },
    "ToolRecord": {
      "additionalProperties": false,
      "properties": {
        "container_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Digest"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ToolRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accepted_record_count": {
      "minimum": 0,
      "title": "Accepted Record Count",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/GenomicEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "genome_build": {
      "$ref": "#/$defs/GenomeBuild"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "policy": {
      "$ref": "#/$defs/CuteSvPolicy"
    },
    "raw_record_count": {
      "minimum": 0,
      "title": "Raw Record Count",
      "type": "integer"
    },
    "rejected_record_count": {
      "minimum": 0,
      "title": "Rejected Record Count",
      "type": "integer"
    },
    "rejection_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Rejection Counts",
      "type": "object"
    },
    "research_only": {
      "const": true,
      "default": true,
      "title": "Research Only",
      "type": "boolean"
    },
    "sample_id": {
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ModuleRunStatus"
    },
    "tool": {
      "$ref": "#/$defs/ToolRecord"
    },
    "vcf_fingerprint": {
      "$ref": "#/$defs/FileFingerprint"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "sample_id",
    "genome_build",
    "status",
    "policy",
    "events",
    "raw_record_count",
    "accepted_record_count",
    "rejected_record_count",
    "tool",
    "vcf_fingerprint"
  ],
  "title": "CuteSvCallReport",
  "type": "object"
}
