<Window x:Class="ONTSeq.Desktop.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ONTSeq Desktop – System einrichten" Height="650" Width="820"
        MinHeight="600" MinWidth="760" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" Background="#F5F7FA" Loaded="Window_Loaded">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="ONTSeq System einrichten" FontSize="28" FontWeight="SemiBold" Foreground="#152238" />
            <TextBlock Text="Die Einrichtung prüft WSL2, installiert die gebündelte Linux-Bioinformatik und legt Reference-Locks an."
                       Margin="0,5,0,0" Foreground="#5F6B7A" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Background="#FFF4CE" BorderBrush="#E8C861" BorderThickness="1"
                CornerRadius="6" Padding="13" Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap" Foreground="#5B4710">
                <Run FontWeight="SemiBold" Text="Wichtig: " />
                <Run Text="Für einen echten BAM muss die gewählte FASTA/FAI exakt zur Referenz passen, gegen die der BAM ausgerichtet wurde. Ein bloßes Label 'GRCh38' reicht nicht. Die App prüft anschließend die BAM-Contigs gegen diesen Lock." />
            </TextBlock>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="WSL2" FontWeight="SemiBold" Margin="0,8" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="WslStatusText" Text="Noch nicht geprüft" Foreground="#5F6B7A" Margin="0,8" />
                <Button Grid.Row="0" Grid.Column="2" x:Name="CheckButton" Content="System prüfen" Click="Check_Click" MinWidth="130" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="ONTSeq Backend" FontWeight="SemiBold" Margin="0,8" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BackendStatusText" Text="Noch nicht geprüft" Foreground="#5F6B7A" Margin="0,8" TextWrapping="Wrap" />
                <Button Grid.Row="1" Grid.Column="2" x:Name="InstallRuntimeButton" Content="Runtime installieren" Click="InstallRuntime_Click" MinWidth="130" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="GRCh38 Reference-Lock" FontWeight="SemiBold" Margin="0,8" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="Grch38StatusText" Text="Nicht konfiguriert" Foreground="#5F6B7A" Margin="0,8" TextWrapping="Wrap" />
                <Button Grid.Row="2" Grid.Column="2" Content="FASTA / FAI wählen…" Click="ConfigureGrch38_Click" MinWidth="130" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="GRCh37 Reference-Lock" FontWeight="SemiBold" Margin="0,8" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="Grch37StatusText" Text="Nicht konfiguriert" Foreground="#5F6B7A" Margin="0,8" TextWrapping="Wrap" />
                <Button Grid.Row="3" Grid.Column="2" Content="FASTA / FAI wählen…" Click="ConfigureGrch37_Click" MinWidth="130" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Engineering-Selbsttest" FontWeight="SemiBold" Margin="0,8" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SelfTestStatusText" Text="Noch nicht ausgeführt" Foreground="#5F6B7A" Margin="0,8" TextWrapping="Wrap" />
                <Button Grid.Row="4" Grid.Column="2" x:Name="SelfTestButton" Content="Selbsttest starten" Click="SelfTest_Click" MinWidth="130" />

                <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Background="#EEF3F8" CornerRadius="5" Padding="12" Margin="0,16,0,0">
                    <TextBlock x:Name="DetailText" Text="System prüfen oder die Runtime installieren."
                               Foreground="#42556E" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="SettingsPathText" Foreground="#758294" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="Fertig" MinWidth="110" Click="Done_Click" />
        </Grid>
    </Grid>
</Window>
