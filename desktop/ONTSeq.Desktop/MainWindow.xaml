<Window x:Class="ONTSeq.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ONTSeq · Genom und Methylierung" Height="900" Width="1100" MinHeight="820" MinWidth="1000"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#F5F7FA"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="ONTSeq" FontSize="30" FontWeight="SemiBold" Foreground="#152238" />
                <TextBlock Text="Genom &amp; Methylierung · lokale Analyse" FontSize="14" Foreground="#5F6B7A" Margin="1,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#E8EEF7" CornerRadius="6" Padding="12,7" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="BackendStateText" Text="Backend wird beim Start geprüft" Foreground="#34465F"
                               MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </Border>
                <Button x:Name="LiveWorkspaceButton" Content="Analyse-Arbeitsplatz öffnen" Click="LiveWorkspace_Click" Padding="12,7"
                        IsEnabled="False"
                        ToolTip="Öffnet die echte lokale ONTSeq-Oberfläche. Startet keinen Analyselauf. Desktop während der Nutzung geöffnet lassen." />
                <Button x:Name="SetupButton" Content="System einrichten" Click="Setup_Click" Padding="12,7" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#FFF4CE" BorderBrush="#E8C861" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,18">
            <TextBlock Text="RESEARCH USE ONLY · nicht klinisch validiert · Ergebnisse erfordern fachliche Prüfung" Foreground="#5B4710" FontWeight="SemiBold" />
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,0,0,18">
            <ScrollViewer x:Name="InputsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="1  BAM auswählen" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="BamPathTextBox" IsReadOnly="True" Margin="0,0,10,10" />
                <Button Grid.Row="0" Grid.Column="2" x:Name="BrowseButton" Content="Auswählen…" Click="Browse_Click" Margin="0,0,0,10" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="2  Proben-ID" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="SampleIdTextBox" Margin="0,0,0,10" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Referenzbuild" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Background="#EEF3F8" CornerRadius="4" Padding="9,6" Margin="0,0,0,10">
                    <TextBlock x:Name="DetectedBuildText" Text="GRCh38 · Profilvorgabe, BAM-Prüfung beim Start"
                               Foreground="#42556E" TextWrapping="Wrap" />
                </Border>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Analyseprofil" VerticalAlignment="Center" FontWeight="SemiBold" />
                <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ProfileCombo"
                          SelectedIndex="0" SelectionChanged="ProfileCombo_SelectionChanged" Margin="0,0,0,8">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ProfileStatusText"
                           Text="Ressourcenstatus wird geprüft…" Foreground="#5F6B7A"
                           TextWrapping="Wrap" Margin="0,0,0,16" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="3  Methylierung" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Border x:Name="MethylationPanel" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Background="#E8F5F3" CornerRadius="6" Padding="12" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock x:Name="MethylationStateText" Text="Nach der BAM-Auswahl wird auf Methylierungsinformationen geprüft." FontWeight="SemiBold" Foreground="#185E63" TextWrapping="Wrap" />
                        <TextBlock x:Name="MethylationExplanationText" Text="Bei erkannten Informationen entscheiden Sie vor dem Start ausdrücklich: ergänzen oder nur Genomanalyse." Foreground="#526B78" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="MethylationProgressText" Foreground="#42556E" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <ProgressBar x:Name="MethylationProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,6,0,0" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="ThoroughProbeButton" Content="Gründlicher prüfen" Click="ThoroughProbe_Click" IsEnabled="False" Padding="10,5" Margin="0,0,8,0" />
                            <Button x:Name="CancelProbeButton" Content="Prüfung abbrechen" Click="CancelProbe_Click" IsEnabled="False" Padding="10,5" Margin="0" />
                        </WrapPanel>
                        <Expander Header="Technische Prüfdetails" FontSize="12" Foreground="#526B78" Margin="0,7,0,0">
                            <TextBlock x:Name="MethylationDetailsText" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </Expander>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <Button x:Name="StartButton" Content="Analyse prüfen &amp; starten" FontWeight="SemiBold" MinWidth="220" Background="#087F80" Foreground="White"
                            Click="Start_Click" IsEnabled="False" />
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <Border x:Name="AnalysisProgressPanel" Grid.Row="3" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="8" Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Analysefortschritt" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="RunStateText" Text="Bereit" Foreground="#5F6B7A" VerticalAlignment="Center" />
                </Grid>
                <ProgressBar Grid.Row="1" x:Name="RunProgress" Height="7" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,14" />
                <Border Grid.Row="2" Background="#F7F9FC" BorderBrush="#E1E6EE" BorderThickness="1"
                        CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                        ToolTip="Stage-Verlauf des Laufs. NO_CALL (kein verwertbarer Call) und NOT_RUN (nicht gelaufen) sind keine Fehler.">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding StageItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="112">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="16" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Height="2" Background="#D3DAE4" VerticalAlignment="Center" />
                                        <Ellipse Grid.Row="0" Width="13" Height="13" HorizontalAlignment="Center"
                                                 Fill="{Binding DotFill}" Stroke="{Binding DotStroke}" StrokeThickness="1.5"
                                                 ToolTip="{Binding NodeToolTip}" />
                                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#33405A" TextAlignment="Center" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="32" Margin="2,3,2,0"
                                                   ToolTip="{Binding NodeToolTip}" />
                                        <TextBlock Grid.Row="2" Text="{Binding StatusCaption}" FontSize="10"
                                                   Foreground="#758294" TextAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding StageItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Symbol}" FontWeight="Bold" FontSize="16" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#4F6073" />
                                    <TextBlock Grid.Column="3" Text="{Binding Reason}" Foreground="#758294" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="DetailText" Text="BAM auswählen, Profil prüfen und Analyseumfang festlegen." Foreground="#5F6B7A" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="OpenReportButton" Content="HTML-Bericht öffnen" IsEnabled="False" Click="OpenReport_Click" />
                <Button x:Name="OpenExcelButton" Content="Excel öffnen" IsEnabled="False" Click="OpenExcel_Click" />
                <Button x:Name="OpenFolderButton" Content="Ergebnisordner" IsEnabled="False" Click="OpenFolder_Click" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
